PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/stackportal
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Gmail SMTP is used for verification, login, and reset codes.
# Use console delivery for local development. Set this to smtp only after
# configuring valid provider credentials below.
EMAIL_MODE=console
REQUIRE_EMAIL_VERIFICATION=true
LOGIN_OTP_REQUIRED=true
MAX_FILE_SIZE=5242880
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Optional: required to create an administrator account
ADMIN_INVITE_CODE=
# Optional development-only seed credentials; never use production passwords here.
SEED_ADMIN_PASSWORD=
SEED_SEEKER_PASSWORD=
JWT_EXPIRES_IN=7d
